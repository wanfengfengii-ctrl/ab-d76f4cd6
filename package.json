{
  "name": "substation-lamp-review",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "变电站指示灯序列切换复核（单灯路卡滞故障的联合状态求解）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "node server.mjs",
    "preview": "node server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "healthcheck": "node scripts/healthcheck.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
